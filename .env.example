# Backend only. Never expose API keys as VITE_ variables or commit real keys.

# NVIDIA NIM / NVIDIA API Catalog
NVIDIA_API_KEY="your_nvidia_api_key"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# Default hosted model for AML reasoning. Override if your NVIDIA account uses another model ID.
NVIDIA_NIM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Optional legacy provider while migration is completed.
GEMINI_API_KEY=""

# Public URL of the deployed frontend (optional server metadata / callbacks).
APP_URL="https://sweater9.github.io/AML-Screening/"

# Allowed browser origin for the backend API.
CORS_ORIGIN="https://sweater9.github.io"

# Frontend build-time setting. Point this at the HTTPS origin where server.ts is deployed.
# Example: https://aml-screening-api.example.com
VITE_API_BASE_URL=""
